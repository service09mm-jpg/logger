# Neon Postgres (обидва рядки бере Vercel Storage → Connect)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Auth.js. AUTH_SECRET — будь-який випадковий рядок: npx auth secret
AUTH_SECRET=

# Google OAuth: console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (Web application). У Authorized redirect URIs треба додати
# https://<домен>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
