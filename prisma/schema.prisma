generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Placeholder model to verify the DB connection end-to-end.
// Replace with the real schema once the app's data model is defined.
model LogEntry {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}
